# Frontend Environment Variables
# In production (e.g. Vercel, Netlify), set this to your hosted backend URL:
# VITE_API_BASE_URL=https://your-backend.onrender.com

# In local development, you can leave it blank to use the Vite proxy,
# or set it explicitly to point to your local backend server:
VITE_API_BASE_URL=http://localhost:5001
